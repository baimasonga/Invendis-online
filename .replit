modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

# NOTE: the [agent] block was removed deliberately. Replit hosts and runs this
# system; it does not author or publish code. Development happens outside Replit
# and lands on GitHub main, which Replit then pulls. Re-enabling the agent (and
# especially its github integration) risks it committing over work done
# elsewhere — see the comments in scripts/post-merge.sh for what that cost us.

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 21464
externalPort = 3000

[[ports]]
localPort = 24635
externalPort = 3003

[[ports]]
localPort = 24636
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EASYSENDSMS_SENDER = "AVDP"
# Production API domain the mobile app talks to. This was previously a transient
# *.replit.dev tunnel URL, which dies with the workspace. The field-app "dev"
# script still overrides this with $REPLIT_DEV_DOMAIN for local Replit dev, and
# the GitHub Actions APK build uses vars.EXPO_PUBLIC_DOMAIN, so this is the
# production default only.
EXPO_PUBLIC_DOMAIN = "www.invendisapp.com"
