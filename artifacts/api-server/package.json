    "@supabase/supabase-js": "^2.105.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "express": "^5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.0",
    "@workspace/api-zod": "workspace:*",
    "esbuild": "^0.27.3",
